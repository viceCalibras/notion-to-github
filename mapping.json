{
  "label": {
    "property": "category",
    "map": {
      "bug": "bug",
      "feature_extraction": "feature_extraction",
      "llm_RAG_ds": "llm_RAG_ds",
      "infra": "infra",
      "platform": "platform",
      "ux": "ux",
      "Testing": "testing"
    }
  },
  "assignees": {
    "property": "responsible",
    "map": {
      "name-in-notion": "name-in-github"
    }
  },
  "status": {
    "property": "status",
    "map": {
      "Not started": "Open",
      "Paused": "Open",
      "In progress": "Open",
      "Done": "Completed"
    }
  },
  "issue_fields": {
    "Priority": {
      "property": "priority",
      "map": {
        "High": "High",
        "Medium": "Medium",
        "Low": "Low"
      }
    },
    "tag": {
      "property": "tag",
      "map": {
        "tag-in-notion": "tag-in-github"
      }
    }
  }
}
